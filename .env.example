# ExtensionLab Phase 3 configuration.
# Never commit real secrets. Only non-sensitive sandbox defaults belong here.

# Docker executable used to manage disposable sandbox containers.
DOCKER_BIN=docker

# Build with: docker build -f sandbox/Dockerfile -t extensionlab-sandbox:local .
SANDBOX_IMAGE=extensionlab-sandbox:local

# Runtime and resource limits
SANDBOX_MAX_RUNTIME=120
SANDBOX_MEMORY_LIMIT=768m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MAX_CONCURRENT=2
SANDBOX_MAX_PER_WINDOW=4
SANDBOX_RATE_LIMIT_WINDOW_MS=60000
SANDBOX_NETWORK_MODE=restricted

# Event limits
SANDBOX_MAX_EVENTS=500
SANDBOX_MAX_EVENT_SIZE=8192
SANDBOX_MAX_LOG_LENGTH=2000
SANDBOX_MAX_NETWORK_EVENTS=200

# Default network policy. Keep restricted unless you have an explicit egress proxy.
SANDBOX_ALLOW_HTTP=false

# Phase 5 persistent workspace
# Local SQLite database path. Use a persistent volume in production.
EXTENSIONLAB_DB_PATH=./data/extensionlab.sqlite

# Free plan limits
PLAN_ANALYSIS_LIMIT=10
PLAN_TEST_LIMIT=5
PLAN_MAX_EXTENSION_SIZE=26214400
PLAN_MAX_CONCURRENT_RUNS=2
PLAN_HISTORY_RETENTION_DAYS=30

# Optional development-only password-reset delivery directory. Never enable in
# production without replacing it with a real email provider.
# EXTENSIONLAB_RESET_DEV_DIR=./data/reset-tokens
