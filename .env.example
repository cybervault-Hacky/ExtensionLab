# ExtensionLab configuration template.
# Copy to `.env` and fill in real values. NEVER commit `.env` or real secrets.
# Every value below is a placeholder or a safe default.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | production | test. Production enforces the mandatory secrets.
APP_ENV=development
# Public origin used in e-mails and links. Must be https:// in production.
APP_URL=http://localhost:3000
# Required in production: >= 32 random characters. Generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (SQLite via node:sqlite). Use a persistent volume in production.
# Legacy EXTENSIONLAB_DB_PATH is still honoured when DATABASE_URL is unset.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:./data/extensionlab.sqlite

# ---------------------------------------------------------------------------
# Storage for uploaded packages and test artifacts
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_PATH=./data/storage

# ---------------------------------------------------------------------------
# Sandbox (Docker). Build the image with: npm run sandbox:build
# ---------------------------------------------------------------------------
DOCKER_BIN=docker
SANDBOX_IMAGE=extensionlab-sandbox:local
# Global and per-user concurrency for sandbox-backed test runs
SANDBOX_MAX_CONCURRENCY=4
SANDBOX_USER_CONCURRENCY=1
# Maximum sandbox lifetime in seconds
SANDBOX_TIMEOUT=120
SANDBOX_MEMORY_LIMIT=768m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_NETWORK_MODE=restricted
SANDBOX_ALLOW_HTTP=false
# Set to true on hosts without Docker to report the sandbox as disabled
SANDBOX_DISABLED=false
# Event limits
SANDBOX_MAX_EVENTS=500
SANDBOX_MAX_EVENT_SIZE=8192
SANDBOX_MAX_LOG_LENGTH=2000
SANDBOX_MAX_NETWORK_EVENTS=200

# ---------------------------------------------------------------------------
# Browsers (Phase 9). Build per-browser images with: npm run sandbox:build:matrix
# ---------------------------------------------------------------------------
# Per-browser pinned images. Chromium falls back to SANDBOX_IMAGE when unset.
# SANDBOX_IMAGE_CHROMIUM=extensionlab-sandbox-chromium:local
# SANDBOX_IMAGE_EDGE=extensionlab-sandbox-edge:local
# SANDBOX_IMAGE_FIREFOX=extensionlab-sandbox-firefox:local
# Version labels recorded with runs (e.g. the image tag you pinned)
# BROWSER_CHROMIUM_VERSION=bundled
# BROWSER_EDGE_VERSION=bundled
# BROWSER_FIREFOX_VERSION=bundled
# Executables inside the containers
# BROWSER_CHROMIUM_EXECUTABLE=chromium
# BROWSER_EDGE_EXECUTABLE=microsoft-edge
# BROWSER_FIREFOX_EXECUTABLE=firefox
# Disable a runtime without rebuilding (0/1/true/false)
# BROWSER_EDGE_ENABLED=true
# Matrix limits
MAX_BROWSERS_PER_MATRIX=3
MAX_MATRIX_TESTS=32
MAX_MATRIX_CONCURRENCY=2
MAX_MATRIX_ARTIFACTS=24
MATRIX_TIMEOUT_MS=480000
MATRIX_BROWSER_TIMEOUT_MS=150000

# ---------------------------------------------------------------------------
# Background jobs / worker
# ---------------------------------------------------------------------------
# embedded (web process runs the worker; development) | external (npm run worker) | disabled
WORKER_MODE=embedded
WORKER_ID=worker-1
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=15000
WORKER_SHUTDOWN_GRACE_MS=20000
JOB_MAX_RETRIES=3
JOB_MAX_QUEUED_PER_USER=3
JOB_MAX_QUEUE_LENGTH=200
CLEANUP_INTERVAL_MS=900000

# ---------------------------------------------------------------------------
# E-mail (password resets). console | file | http | noop
# Production allows only http or noop.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=ExtensionLab <no-reply@localhost>
# EMAIL_FILE_DIR=./data/outbox
# EMAIL_HTTP_URL=https://mail-relay.example.com/send
# EMAIL_HTTP_TOKEN=replace-with-provider-token

# ---------------------------------------------------------------------------
# Rate limits (requests per minute per client)
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MIN=30
RATE_LIMIT_SIGNUP_PER_MIN=30
RATE_LIMIT_FORGOT_PASSWORD_PER_MIN=10
RATE_LIMIT_RESET_PASSWORD_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=30
RATE_LIMIT_TEST_CREATE_PER_MIN=20
RATE_LIMIT_SANDBOX_CREATE_PER_MIN=10
RATE_LIMIT_SHARE_CREATE_PER_MIN=20
RATE_LIMIT_PUBLIC_REPORT_PER_MIN=60
RATE_LIMIT_REPORT_CREATE_PER_MIN=30

# ---------------------------------------------------------------------------
# Retention (days unless noted). Applied by the scheduled cleanup job.
# ---------------------------------------------------------------------------
PACKAGE_RETENTION_DAYS=30
ARTIFACT_RETENTION_DAYS=14
RESET_TOKEN_RETENTION_DAYS=1
SESSION_RETENTION_DAYS=7
JOB_RETENTION_DAYS=14
SHARE_RETENTION_DAYS=30
STALE_JOB_DAYS=1
STALE_RUN_MINUTES=30

# ---------------------------------------------------------------------------
# Plans (Phase 7). Three plans exist: free, pro, business. Every limit is
# configurable per plan with PLAN_<FREE|PRO|BUSINESS>_<SETTING>; the legacy
# PLAN_* names below still apply to the Free plan. See docs/PLANS.md.
# ---------------------------------------------------------------------------
PLAN_ANALYSIS_LIMIT=10
PLAN_TEST_LIMIT=5
PLAN_MAX_EXTENSION_SIZE=26214400
PLAN_MAX_CONCURRENT_RUNS=1
PLAN_HISTORY_RETENTION_DAYS=30
# PLAN_PRO_ANALYSIS_LIMIT=200
# PLAN_PRO_TEST_LIMIT=100
# PLAN_PRO_MAX_CONCURRENT_RUNS=2
# PLAN_BUSINESS_ANALYSIS_LIMIT=1000
# PLAN_BUSINESS_TEST_LIMIT=500
# PLAN_BUSINESS_MAX_CONCURRENT_RUNS=4

# ---------------------------------------------------------------------------
# Billing (Phase 7). See docs/BILLING.md.
#   BILLING_PROVIDER: stripe | fake | disabled
#     - defaults to "fake" in development/test and to "disabled" in production
#       ("fake" is rejected in production; "stripe" requires the keys below).
#   Secrets are read from the environment only. Never commit real values.
# ---------------------------------------------------------------------------
BILLING_PROVIDER=fake
# BILLING_SECRET_KEY=                       # provider secret/restricted key (live key required in production)
# BILLING_WEBHOOK_SECRET=                   # webhook signing secret from the provider dashboard
# BILLING_PRO_PRICE_ID=price_...             # provider price id for the Pro plan
# BILLING_BUSINESS_PRICE_ID=price_...        # provider price id for the Business plan
# BILLING_CURRENCY=inr                       # display currency (ISO 4217, lower-case)
# BILLING_PRO_AMOUNT=79900                   # display amount in minor units (e.g. paise/cents)
# BILLING_BUSINESS_AMOUNT=249900
# BILLING_PAST_DUE_GRACE_DAYS=7              # keep paid features this long after a failed renewal
# BILLING_DELETION_POLICY=cancel_immediately # or cancel_at_period_end
# BILLING_FAKE_WEBHOOK_SECRET=whsec_fake_dev # fake provider only (dev/test)
# RATE_LIMIT_BILLING_READ_PER_MIN=60
# RATE_LIMIT_BILLING_CHECKOUT_PER_MIN=5
# RATE_LIMIT_BILLING_PORTAL_PER_MIN=5
# RATE_LIMIT_BILLING_CHANGE_PER_MIN=10
# RATE_LIMIT_BILLING_WEBHOOK_PER_MIN=600

# ---------------------------------------------------------------------------
# AI assistance (Phase 8). See docs/AI.md.
#   AI_PROVIDER: openai | fake | disabled
#     - defaults to "fake" in development/test and to "disabled" in production
#       ("fake" is rejected in production; "openai" requires AI_API_KEY).
#     - "disabled" keeps every AI control hidden/unavailable; nothing else changes.
#   The API key is read from the environment only: never in the client bundle,
#   logs, reports or the database. Never commit a real key.
# ---------------------------------------------------------------------------
AI_PROVIDER=fake
# AI_API_KEY=                               # provider API key (required for openai)
# AI_MODEL=gpt-4o-mini                      # model name passed to the provider
# AI_BASE_URL=https://api.openai.com/v1     # any OpenAI-compatible endpoint; https required in production
# AI_TIMEOUT=20                             # seconds per provider call (1-120)
# AI_MAX_REQUEST_BYTES=16384                # max JSON body accepted by /api/ai/*
# AI_MAX_CONTEXT_BYTES=24576                # max sanitized evidence sent per request
# AI_MAX_OUTPUT_TOKENS=1200                 # completion budget per request
# AI_MAX_RESPONSE_BYTES=65536               # max provider response read
# AI_MAX_CONCURRENCY=4                      # in-flight provider calls per process
# AI_MAX_CONCURRENCY_PER_USER=1
# AI_RESULT_RETENTION_DAYS=30               # stored (validated) AI results; 0 disables reuse
# RATE_LIMIT_AI_PER_MIN=10                  # per user, separate from analysis/test limits
# Plan entitlements (Free: not included; Pro 100; Business 500 requests/period)
# PLAN_FREE_AI_ENABLED=false
# PLAN_FREE_AI_LIMIT=0
# PLAN_PRO_AI_LIMIT=100
# PLAN_BUSINESS_AI_LIMIT=500

# ---------------------------------------------------------------------------
# Development only. Rejected by config validation in production.
# ---------------------------------------------------------------------------
# EXTENSIONLAB_RESET_DEV_DIR=./data/reset-tokens

# ---------------------------------------------------------------------------
# Phase 10 — organizations, public API, webhooks, scale (defaults are safe)
# ---------------------------------------------------------------------------
# Workspaces & organizations
# ORG_MAX_PER_USER=10            # organizations a user may own
# ORG_MAX_MEMBERS=50             # hard member ceiling
# ORG_MAX_PROJECTS_PER_ORG=100
# ORG_MAX_API_KEYS_PER_ORG=20
# ORG_MAX_WEBHOOKS_PER_ORG=10
# ORG_INVITATION_TTL_MS=604800000          # 7 days
# ORG_DEFAULT_PLAN=free
# ORG_PLAN_FREE_MAX_MEMBERS=2              # org plan entitlement overrides
# ORG_PLAN_PRO_API_ACCESS=true
# ORG_PLAN_BUSINESS_SSO=true
# AUDIT_RETENTION_DAYS=365                 # org audit retention floor
# EXPORT_EXPIRY_MS=86400000                 # export download window (24h)
# EXPORT_RETENTION_DAYS=7                  # artifact retention after completion

# Public API (/api/v1)
# PUBLIC_API_ENABLED=true
# API_KEY_TTL_MS=31536000000               # default key lifetime (365d)
# API_RATE_LIMIT_READ_PER_MIN=240          # per key/org/ip, per endpoint class
# API_RATE_LIMIT_UPLOAD_PER_MIN=30
# API_RATE_LIMIT_ANALYSIS_PER_MIN=60
# API_RATE_LIMIT_TEST_PER_MIN=30
# API_RATE_LIMIT_MATRIX_PER_MIN=10
# API_RATE_LIMIT_REPORT_PER_MIN=120

# Webhooks (organization events)
# WEBHOOK_TIMEOUT=10000                    # ms per delivery attempt
# WEBHOOK_MAX_RETRIES=5                    # then dead-letter
# WEBHOOK_BACKOFF_BASE_MS=30000            # exponential backoff base (cap 1h)
# WEBHOOK_MAX_PAYLOAD_BYTES=32768
# WEBHOOK_HISTORY_PER_WEBHOOK=100

# Coordination (multi-worker rate limiting & locks)
# COORDINATION_PROVIDER=memory            # memory (dev/single node) | redis
# REDIS_URL=redis://localhost:6379        # required when COORDINATION_PROVIDER=redis

# SSO configuration layer
# SSO_ENABLED=false                       # enables org SSO configuration UI/API

# Job system fairness
# ORG_MAX_CONCURRENCY=5                   # global ceiling applied after plan limits
# ORG_FAIRNESS_SCAN_LIMIT=50              # queue scan window for fair claiming

# Production database (PostgreSQL). SQLite (file under EXTENSIONLAB_DB_PATH) is the
# development default; a postgres:// URL changes driver expectations — see DEPLOYMENT.
# DATABASE_URL=

# Internal admin abstraction (jobs/queue ONLY — no shell, no Docker execution).
# Fail closed: enabling without a token is a startup validation error, and the
# surface is invisible (404) when disabled.
# ADMIN_API_ENABLED=false
# ADMIN_API_TOKEN=                           # strong random value; stored hashed

# Phase 10 real-infrastructure e2e flags (CI). Default: suites skip with an
# explicit reason; when a flag is set, missing infrastructure is a hard failure.
# EXTENSIONLAB_E2E_POSTGRES=1                # + DATABASE_URL=postgres://…
# EXTENSIONLAB_E2E_REDIS=1                   # + COORDINATION_PROVIDER=redis, REDIS_URL=…
# EXTENSIONLAB_E2E_WEBHOOKS=1                # real HTTP receiver end-to-end (self-contained)
