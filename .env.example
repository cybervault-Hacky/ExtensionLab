# ExtensionLab configuration template.
# Copy to `.env` and fill in real values. NEVER commit `.env` or real secrets.
# Every value below is a placeholder or a safe default.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | production | test. Production enforces the mandatory secrets.
APP_ENV=development
# Public origin used in e-mails and links. Must be https:// in production.
APP_URL=http://localhost:3000
# Required in production: >= 32 random characters. Generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (SQLite via node:sqlite). Use a persistent volume in production.
# Legacy EXTENSIONLAB_DB_PATH is still honoured when DATABASE_URL is unset.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:./data/extensionlab.sqlite

# ---------------------------------------------------------------------------
# Storage for uploaded packages and test artifacts
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_PATH=./data/storage

# ---------------------------------------------------------------------------
# Sandbox (Docker). Build the image with: npm run sandbox:build
# ---------------------------------------------------------------------------
DOCKER_BIN=docker
SANDBOX_IMAGE=extensionlab-sandbox:local
# Global and per-user concurrency for sandbox-backed test runs
SANDBOX_MAX_CONCURRENCY=4
SANDBOX_USER_CONCURRENCY=1
# Maximum sandbox lifetime in seconds
SANDBOX_TIMEOUT=120
SANDBOX_MEMORY_LIMIT=768m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_NETWORK_MODE=restricted
SANDBOX_ALLOW_HTTP=false
# Set to true on hosts without Docker to report the sandbox as disabled
SANDBOX_DISABLED=false
# Event limits
SANDBOX_MAX_EVENTS=500
SANDBOX_MAX_EVENT_SIZE=8192
SANDBOX_MAX_LOG_LENGTH=2000
SANDBOX_MAX_NETWORK_EVENTS=200

# ---------------------------------------------------------------------------
# Background jobs / worker
# ---------------------------------------------------------------------------
# embedded (web process runs the worker; development) | external (npm run worker) | disabled
WORKER_MODE=embedded
WORKER_ID=worker-1
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_MS=15000
WORKER_SHUTDOWN_GRACE_MS=20000
JOB_MAX_RETRIES=3
JOB_MAX_QUEUED_PER_USER=3
JOB_MAX_QUEUE_LENGTH=200
CLEANUP_INTERVAL_MS=900000

# ---------------------------------------------------------------------------
# E-mail (password resets). console | file | http | noop
# Production allows only http or noop.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM=ExtensionLab <no-reply@localhost>
# EMAIL_FILE_DIR=./data/outbox
# EMAIL_HTTP_URL=https://mail-relay.example.com/send
# EMAIL_HTTP_TOKEN=replace-with-provider-token

# ---------------------------------------------------------------------------
# Rate limits (requests per minute per client)
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MIN=30
RATE_LIMIT_SIGNUP_PER_MIN=30
RATE_LIMIT_FORGOT_PASSWORD_PER_MIN=10
RATE_LIMIT_RESET_PASSWORD_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=30
RATE_LIMIT_TEST_CREATE_PER_MIN=20
RATE_LIMIT_SANDBOX_CREATE_PER_MIN=10
RATE_LIMIT_SHARE_CREATE_PER_MIN=20
RATE_LIMIT_PUBLIC_REPORT_PER_MIN=60
RATE_LIMIT_REPORT_CREATE_PER_MIN=30

# ---------------------------------------------------------------------------
# Retention (days unless noted). Applied by the scheduled cleanup job.
# ---------------------------------------------------------------------------
PACKAGE_RETENTION_DAYS=30
ARTIFACT_RETENTION_DAYS=14
RESET_TOKEN_RETENTION_DAYS=1
SESSION_RETENTION_DAYS=7
JOB_RETENTION_DAYS=14
SHARE_RETENTION_DAYS=30
STALE_JOB_DAYS=1
STALE_RUN_MINUTES=30

# ---------------------------------------------------------------------------
# Plan limits (free plan)
# ---------------------------------------------------------------------------
PLAN_ANALYSIS_LIMIT=10
PLAN_TEST_LIMIT=5
PLAN_MAX_EXTENSION_SIZE=26214400
PLAN_MAX_CONCURRENT_RUNS=2
PLAN_HISTORY_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Development only. Rejected by config validation in production.
# ---------------------------------------------------------------------------
# EXTENSIONLAB_RESET_DEV_DIR=./data/reset-tokens
