{
  "manifest_version": 3,
  "name": "ExtensionLab Interactive Fixture",
  "version": "1.0.0",
  "description": "Deterministic Manifest V3 fixture for the interactive browser real-Docker end-to-end suite.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Interactive Fixture" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
